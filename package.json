{
  "name": "timebloom",
  "version": "1.0.0",
  "description": "🌸 TimeBloom - Your adorable time management companion (时间管理大师)",
  "main": "electron.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "icon": "node scripts/create-icon.cjs",
    "dist": "node scripts/create-icon.cjs && vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "productivity",
    "calendar",
    "time-management"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tiptap/extension-color": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.timebloom.app",
    "productName": "TimeBloom",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "build/icon.png"
    ]
  }
}
